# Salin ke .env.local lalu isi. Jangan pernah commit nilai asli.
APP_ENV=development
# APP_ENV=production membuka indeks mesin pencari (robots.txt); nilai lain menutup semuanya (staging/lokal).
# Isi APP_ENV dan APP_URL di server (runtime) DAN saat build, supaya metadata statis ikut benar.
APP_URL=http://localhost:3000

# PostgreSQL (database pengembangan)
DATABASE_URL=postgres://inovasi_app:GANTI_PASSWORD@localhost:5432/inovasi_dev

# Database KHUSUS tes integrasi. Namanya wajib berakhiran _test dan berbeda dari DATABASE_URL.
# Isinya dikosongkan setiap tes dijalankan.
DATABASE_URL_TEST=postgres://inovasi_app:GANTI_PASSWORD@localhost:5432/inovasi_test

# Hanya pengembangan lokal: isi 1 untuk menampilkan data [DUMMY] di katalog. Diabaikan di produksi.
DUMMY_DATA=
